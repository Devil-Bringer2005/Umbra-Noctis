--- !u!114 &1319890294738773713
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1930753146633460414}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 535c49a3c58746c41bc70e0f1c6536e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  AudioClip: {fileID: 8300000, guid: 0e25b69ee8bbb0b4d90f3f9f2fc44215, type: 3}
  dialoguePanel: {fileID: 1281173828}
  interactPrompt: {fileID: 0}
  dialogueText: {fileID: 948240521}
  dialogue:
  - 'Hoot - Hoot !!! , '
  - '"Beware, traveler, for the house ahead whispers tales of sorrow and shadows.
    Its walls remember what the living have long forgotten."'
  - The light fades quickly within, and the air itself seems to watch. Tread carefully,
    or you may leave more of yourself behind than you bargained for."
  - '"Not all spirits slumber kindly. Some linger, restless and wrathful, bound to
    the very stones of that cursed place."'
  SFXSource: {fileID: 1485145142}
  dialogueImage: {fileID: 2104637231}
  npcImage: {fileID: 363807906, guid: bd090299ae37fa34b8d60909a16a59ea, type: 3}
  NpcNameUI: {fileID: 64768068}
  NpcName: Wise Owl
  wordSpeed: 0.06
  playerIsClose: 0
  boxCollider: {fileID: 1796626988338721574}
  interaction: {fileID: 353534998}
